# Copy to `.env` to override defaults. Nothing here is secret; never commit a real `.env`.
# Used by `docker compose` (variable substitution) and by `npm run dev` (loaded by the API).

# --- Docker ports (host side) ---
WEB_PORT=8080
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# --- API ---
# HOST=127.0.0.1             # docker compose sets 0.0.0.0 inside the container
# PORT=3000
LOG_LEVEL=info

# Product data source
FAKESTORE_BASE_URL=https://fakestoreapi.com
UPSTREAM_TIMEOUT_MS=5000
CACHE_TTL_SECONDS=300

# Curated "top rated" products (path relative to apps/api)
# FEATURED_PRODUCTS_FILE=config/featured-products.json
CATEGORY_TOP_RATED_LIMIT=3

# Email. `console` logs emails (no SMTP needed); `smtp` delivers via SMTP (docker compose uses Mailpit).
# For `npm run dev` with a real inbox: `docker compose up -d mailpit`, then set EMAIL_PROVIDER=smtp and
# SMTP_HOST=127.0.0.1 here; emails appear at http://localhost:8025.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Product Catalogue <no-reply@catalogue.local>
SALES_INBOX_EMAIL=sales@catalogue.local

# Used to build product links in enquiry emails
PUBLIC_WEB_URL=http://localhost:8080
